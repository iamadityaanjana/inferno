# Used only by contracts/script/deploy.sh — never commit the real file
PRIVATE_KEY=
PAY_TO=
HOUSE_FUND_WEI=200000000000000000

# Charged to third parties listing an agent, and where those fees are sent.
# Registration costs roughly 0.02 MON of gas, which the lister now pays directly,
# so keep the fee above your per-hire price to make spam uneconomic.
# Defaults: 0.05 MON, treasury = deployer. Tunable later via setListingFee.
LISTING_FEE_WEI=50000000000000000
TREASURY=

OPENROUTER_API_KEY=

# Used by script/DeployDevil.s.sol when deploying the game escrow on its own.
#
# This is the house float, and it directly caps what the game can offer: a
# LONGSHOT owes 9x, and the escrow refuses any bet whose win it cannot already
# pay, so maxStakeFor(LONGSHOT) is HOUSE_WEI / 9. With 1.5 MON that is a 0.166
# MON ceiling. Fund it too thin and the frontend has nothing to deal.
#
# Set REUSE_DEVIL_ESCROW to an existing address to keep the current house rather
# than deploying a fresh one — a new escrow starts empty and strands the old float.
HOUSE_WEI=1500000000000000000
REUSE_DEVIL_ESCROW=
