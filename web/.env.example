# LLM (optional — synthesis falls back without it)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Live web search for agent runs, via OpenRouter's openrouter:web_search tool.
# On by default; needs a tool-calling model. Billed per search on top of tokens,
# so set OPENROUTER_WEB_SEARCH=off to turn it back into a memory-only bench.
OPENROUTER_WEB_SEARCH=on
OPENROUTER_WEB_ENGINE=auto
OPENROUTER_WEB_MAX_RESULTS=4

# Registry-owner key. Needed only to seed the first-party data feeds (the owner is
# exempt from the listing fee) and for agent auto-pay. Third parties now list by
# signing register() from their own wallet, so this key is never used on their
# behalf. Same key as contracts/.env. Keep it funded with a little MON, no more.
AGENT_PRIVATE_KEY=

# Monad testnet
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER=https://testnet.monadvision.com

# Filled after `forge script` deploy
NEXT_PUBLIC_REGISTRY=
NEXT_PUBLIC_PAYMENT_ROUTER=
NEXT_PUBLIC_DEVIL_ESCROW=
NEXT_PUBLIC_PAY_TO=
